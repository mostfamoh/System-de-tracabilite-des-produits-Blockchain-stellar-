# ==============================================
# DJANGO CONFIGURATION
# ==============================================

# Secret Key - CHANGE THIS IN PRODUCTION!
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-your-secret-key-here-change-in-production

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# Development - SQLite (default, no setup needed)
DATABASE_URL=sqlite:///db.sqlite3

# Production - PostgreSQL (recommended)
# DATABASE_URL=postgresql://username:password@localhost:5432/traceability_db

# ==============================================
# CORS CONFIGURATION
# ==============================================

# Frontend URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================
# JWT TOKEN SETTINGS
# ==============================================

JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# ==============================================
# STELLAR BLOCKCHAIN
# ==============================================

# Network: TESTNET or PUBLIC
STELLAR_NETWORK=TESTNET

# Get test credentials: https://laboratory.stellar.org/#account-creator?network=test
STELLAR_SOURCE_PUBLIC=your-stellar-public-key
STELLAR_SOURCE_SECRET=your-stellar-secret-key

# ==============================================
# EMAIL (Optional)
# ==============================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ==============================================
# FILE STORAGE
# ==============================================

MEDIA_ROOT=media/
MEDIA_URL=/media/
STATIC_ROOT=staticfiles/
STATIC_URL=/static/

# ==============================================
# SECURITY (Production)
# ==============================================

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
