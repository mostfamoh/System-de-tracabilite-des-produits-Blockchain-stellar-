{
  "info": {
    "name": "Product Traceability API",
    "description": "API Collection for Product Traceability System\n\nQuick Start:\n1. Import this collection and environment\n2. Login with test user\n3. Access token is saved automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('access_token', jsonData.access);",
                  "    pm.environment.set('refresh_token', jsonData.refresh);",
                  "    console.log('✅ Logged in successfully!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{manufacturer_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_url}}/auth/login/",
              "host": ["{{api_url}}"],
              "path": ["auth", "login", ""]
            },
            "description": "Login with test user credentials"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/users/me/",
              "host": ["{{api_url}}"],
              "path": ["users", "me", ""]
            },
            "description": "Get currently logged in user details"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_url}}/auth/logout/",
              "host": ["{{api_url}}"],
              "path": ["auth", "logout", ""]
            }
          }
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/products/",
              "host": ["{{api_url}}"],
              "path": ["products", ""]
            },
            "description": "Get all products (filtered by user role)"
          }
        },
        {
          "name": "Get Product Details",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Make sure product_id is set in environment"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/products/{{product_id}}/",
              "host": ["{{api_url}}"],
              "path": ["products", "{{product_id}}", ""]
            },
            "description": "Get detailed product information including all steps"
          }
        },
        {
          "name": "Create Product (Manufacturer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('product_id', jsonData.id);",
                  "    console.log('✅ Product created: ' + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Product\",\n  \"sku\": \"TEST-SKU-001\",\n  \"batch_number\": \"BATCH-001\",\n  \"description\": \"Test product for API testing\",\n  \"category\": null,\n  \"production_date\": \"2025-12-09\",\n  \"unit_price\": 99.99,\n  \"currency\": \"DZ\",\n  \"current_location\": \"Factory - Algiers\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_url}}/products/",
              "host": ["{{api_url}}"],
              "path": ["products", ""]
            },
            "description": "Create a new product (Manufacturer only)"
          }
        }
      ]
    },
    {
      "name": "3. Product Steps",
      "item": [
        {
          "name": "Add Quality Check",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
