              }
            },
            "url": {
              "raw": "{{api_url}}/products/{{product_id}}/add_step/",
              "host": ["{{api_url}}"],
              "path": ["products", "{{product_id}}", "add_step", ""]
            },
            "description": "Store receives product"
          }
        },
        {
          "name": "Sale",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"step_type\": \"SALE\",\n  \"location\": \"Retail Store Downtown\",\n  \"details\": {\n    \"description\": \"Product sold to customer\",\n    \"notes\": \"Transaction completed\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_url}}/products/{{product_id}}/add_step/",
