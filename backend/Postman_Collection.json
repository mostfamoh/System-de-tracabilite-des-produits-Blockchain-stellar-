            },
            "url": {
              "raw": "{{api_url}}/products/{{product_id}}/add_step/",
              "host": ["{{api_url}}"],
              "path": ["products", "{{product_id}}", "add_step", ""]
            },
            "description": "Warehouse ships product to store"
          }
        },
        {
          "name": "Store Entry",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"step_type\": \"STORE_ENTRY\",\n  \"location\": \"Retail Store Downtown\",\n  \"details\": {\n    \"description\": \"Product received at store\",\n    \"notes\": \"Placed on display shelf\"\n  }\n}",
              "options": {
