              "path": ["products", "{{product_id}}", "add_step", ""]
            },
            "description": "Store records sale"
          }
        }
      ]
    },
    {
      "name": "4. Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/dashboard/stats/",
              "host": ["{{api_url}}"],
              "path": ["dashboard", "stats", ""]
            },
            "description": "Get dashboard statistics for current user"
          }
        }
      ]
    },
    {
      "name": "5. Admin - Users",
      "item": [
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/users/",
              "host": ["{{api_url}}"],
              "path": ["users", ""]
            },
            "description": "Get all users (Admin only)"
          }
        },
        {
          "name": "Get Pending Registrations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/registration-requests/?status=PENDING",
              "host": ["{{api_url}}"],
              "path": ["registration-requests", ""],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            },
            "description": "Get pending registration requests (Admin only)"
          }
        }
      ]
    }
  ]
}
