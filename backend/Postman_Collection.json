              "mode": "raw",
              "raw": "{\n  \"step_type\": \"WAREHOUSE_EXIT\",\n  \"location\": \"Warehouse Loading Dock\",\n  \"details\": {\n    \"description\": \"Product shipped to store\",\n    \"notes\": \"Package prepared for delivery\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
